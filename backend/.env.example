# Copiaza fisierul ca backend/.env si completeaza JWT_SECRET_KEY (.env nu intra in git)

# Obligatoriu, minim 16 caractere:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24

# Baza de date: PostgreSQL din containerul db (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://vpp:vpp@localhost:15432/vpp

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:13000,http://localhost:5173

# Simulare
SIM_CONTROLLER=reguli        # reguli | mpc
SIM_TICK_SECONDS=2           # secunde reale per pas simulat
SIM_STEP_MINUTES=5           # durata unui pas simulat (minute)
SIM_SEED=42
# SIM_START_DATE=2025-06-01  # implicit: ziua de azi
SIM_AUTOSTART=true
SIM_DATA=real                # real = PV Bacau + preturi PZU din backend/data; sintetic = generate
SIM_PRICE_YEAR=2025          # anul preturilor PZU: 2023 | 2025 | 2026 (PV ramane cel din 2023)

# Bani (lei) la prima pornire / la reset
INITIAL_WALLET_LEI=100
OPERATOR_WALLET_LEI=10000
