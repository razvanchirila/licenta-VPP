# Copiaza fisierul ca backend/.env; valorile de mai jos sunt suficiente pentru rulare locala (.env nu intra in git)

# Secretul cu care se semneaza token-urile JWT. Valoarea de aici e doar pentru dezvoltare;
# pentru orice alta folosire se genereaza una noua:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-schimba-in-productie-9f3c1a7e2b8d4c6f
JWT_EXPIRE_HOURS=24

# Baza de date (implicit un fisier SQLite in backend/; o cale relativa e fata de backend/, nu de directorul curent)
DATABASE_URL=sqlite+aiosqlite:///./vpp.db

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*

# Simulare
SIM_CONTROLLER=reguli        # reguli | mpc
SIM_TICK_SECONDS=2           # secunde reale per pas simulat
SIM_DT_HOURS=0.25            # durata unui pas simulat (ore)
SIM_SEED=42
# SIM_START_DATE=2025-06-01  # implicit: ziua de azi
SIM_AUTOSTART=true
SIM_DATA=real                # real = PV Bacau + preturi PZU din backend/data; sintetic = generate
SIM_PRICE_YEAR=2023

# Bani (lei) la prima pornire / la reset
INITIAL_WALLET_LEI=100
OPERATOR_WALLET_LEI=10000
