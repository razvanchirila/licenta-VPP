# Pe server se copiaza ca /opt/vpp/.env (chmod 600). setup-server.sh il creeaza singur daca lipseste
# si genereaza cele doua secrete cu openssl rand; fisierul .env nu intra niciodata in git.
COMPOSE_FILE=docker-compose.prod.yml
DOMAIN=vpp-licenta.switzerlandnorth.cloudapp.azure.com
STAGING_DOMAIN=staging.51.107.88.91.nip.io
TAG=latest

POSTGRES_PASSWORD=
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24
# parola conturilor demo (admin, user1..user10); setup-server.sh o genereaza, se schimba cu set-demo-password.sh
DEMO_PASSWORD=

SIM_CONTROLLER=reguli
SIM_TICK_SECONDS=2
SIM_DATA=real
SIM_PRICE_YEAR=2025
